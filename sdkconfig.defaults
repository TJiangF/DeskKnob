# ---------- Target ----------
CONFIG_IDF_TARGET="esp32s3"

# ---------- Flash / partition ----------
# Module is ESP32-S3 with 16MB flash (see `esptool flash-id`).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---------- PSRAM (embedded 8MB, octal) ----------
# DISABLED: enabling PSRAM causes a hard watchdog reset (TG1WDT_SYS_RST) a few
# seconds after motor init. The SimpleFOC 6-PWM MCPWM path plus the AS5600 I2C
# reads in the real-time control loop become unsafe once the cache is backed by
# PSRAM on this board, so core 1 stops feeding its idle watchdog. The module has
# 16MB flash which is ample for this firmware, so PSRAM stays off.
# To revisit: profile the FOC/ISR path (IRAM_ATTR, move sensor reads off the
# control loop, or use the LEDC 3PWM driver) before re-enabling.
# CONFIG_SPIRAM is not set

# ---------- CPU / FreeRTOS ----------
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_UNICORE=n
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_TIMER_TASK_STACK_SIZE=4096

# ---------- Compiler / logs ----------
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ---------- I2C ----------
CONFIG_I2C_ISR_IRAM_SAFE=n

# ---------- LVGL ----------
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_MEM_CUSTOM=y
# No system-monitor overlay: its per-frame label redraw forced a full-screen
# refresh every LVGL tick, which visibly increased motor jitter. Keep it off.
CONFIG_LV_USE_SYSMON=n
CONFIG_LV_USE_PERF_MONITOR=n
CONFIG_LV_USE_MEM_MONITOR=n
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_40=y

# ---------- Bluetooth (BLE HID consumer control for media keys) ----------
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_EXT_ADV=n
